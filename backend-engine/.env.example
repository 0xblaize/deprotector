# Render service: backend-engine
PORT=10000

# Botchain is the primary monitored network. Use official values only.
BOTCHAIN_NETWORK_NAME=
BOTCHAIN_CHAIN_ID=
BOTCHAIN_HTTP_RPC_URL=
BOTCHAIN_WS_RPC_URL=
BOTCHAIN_IS_L2=true

# Optional secondary networks; leave blank when unused.
ETH_NETWORK_NAME=
ETH_CHAIN_ID=
ETH_HTTP_RPC_URL=
ETH_WS_RPC_URL=
BASE_NETWORK_NAME=
BASE_CHAIN_ID=
BASE_HTTP_RPC_URL=
BASE_WS_RPC_URL=
ROBINHOOD_NETWORK_NAME=
ROBINHOOD_CHAIN_ID=
ROBINHOOD_HTTP_RPC_URL=
ROBINHOOD_WS_RPC_URL=

# Required when running the extension against this service.
TELEMETRY_API_KEY=
CORS_ORIGIN=https://your-website.example.com

# Optional persistence services.
REDIS_URL=
DATABASE_URL=

# Leave empty for the current alert-only MVP.
GUARDIAN_PRIVATE_KEY=
FLASHBOTS_RELAY_KEY=
