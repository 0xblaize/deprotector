# Deprotector production environment template
# Copy this file into the relevant service environment. Never commit real secrets.

# -----------------------------------------------------------------------------
# Website / Next.js (Vercel: frontend)
# -----------------------------------------------------------------------------
# Set this after the Chrome Web Store listing is published.
NEXT_PUBLIC_CHROME_WEB_STORE_URL=https://chromewebstore.google.com/detail/your-extension-id

# Public frontend URL, used when configuring the extension and backend CORS.
NEXT_PUBLIC_APP_URL=https://your-website.example.com
# Comma-separated token:spender:symbol entries; leave empty until verified contracts are known.
NEXT_PUBLIC_APPROVAL_TARGETS=

# -----------------------------------------------------------------------------
# Backend API (Node/Express: backend-engine)
# -----------------------------------------------------------------------------
PORT=4000

# Primary network: Botchain. Use only official values from Botchain documentation.
BOTCHAIN_NETWORK_NAME=
BOTCHAIN_CHAIN_ID=
BOTCHAIN_HTTP_RPC_URL=
BOTCHAIN_WS_RPC_URL=
BOTCHAIN_IS_L2=true

# Optional secondary EVM networks.
ETH_NETWORK_NAME=
ETH_CHAIN_ID=
ETH_HTTP_RPC_URL=
ETH_WS_RPC_URL=

BASE_NETWORK_NAME=
BASE_CHAIN_ID=
BASE_HTTP_RPC_URL=
BASE_WS_RPC_URL=

ROBINHOOD_NETWORK_NAME=
ROBINHOOD_CHAIN_ID=
ROBINHOOD_HTTP_RPC_URL=
ROBINHOOD_WS_RPC_URL=

# Backend security. Generate a long random value; do not use a wallet key here.
TELEMETRY_API_KEY=
CORS_ORIGIN=https://your-website.example.com

# Persistent storage, if enabled by the backend deployment.
REDIS_URL=
DATABASE_URL=

# Guardian signing is disabled in the alert-only MVP.
# Do not set these until the smart-account flow is audited and authorized.
GUARDIAN_PRIVATE_KEY=
FLASHBOTS_RELAY_KEY=

# -----------------------------------------------------------------------------
# Chrome extension configuration (Chrome storage, not bundled secrets)
# -----------------------------------------------------------------------------
# Configure these in the extension Options page after installation.
EXTENSION_API_BASE_URL=https://api.your-domain.example.com
EXTENSION_DASHBOARD_URL=https://your-website.example.com/dashboard

# -----------------------------------------------------------------------------
# Smart contracts (Hardhat: smart-contracts)
# -----------------------------------------------------------------------------
# Use a separate deployment environment. Never share deployer keys publicly.
CONTRACT_BOTCHAIN_HTTP_RPC_URL=
CONTRACT_BOTCHAIN_CHAIN_ID=
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=
GUARDIAN_ADDRESS=
RESCUE_VAULT_ADDRESS=

# -----------------------------------------------------------------------------
# Required accounts and services to obtain before production
# -----------------------------------------------------------------------------
# 1. Official Botchain chain ID, HTTP RPC, and optional WebSocket RPC.
# 2. Production HTTPS domain for the website.
# 3. Production HTTPS domain for the backend API.
# 4. Chrome Web Store developer account and published extension ID.
# 5. RPC provider credentials for any secondary networks.
# 6. Database/Redis service if persistent telemetry is enabled.
# 7. Testnet deployer, owner, guardian, and rescue-vault addresses.
# 8. Monitoring and error-reporting credentials, if used by the host.
