# Website (Vercel, root: frontend)
NEXT_PUBLIC_APP_URL=https://your-website.example.com
NEXT_PUBLIC_CHROME_WEB_STORE_URL=
NEXT_PUBLIC_GUARD_FACTORY_ADDRESS=
# token-address:spender-address:SYMBOL entries, only verified contracts
NEXT_PUBLIC_APPROVAL_TARGETS=

# Backend (Node service, root: backend-engine)
PORT=4000
BOTCHAIN_NETWORK_NAME=
BOTCHAIN_CHAIN_ID=
BOTCHAIN_HTTP_RPC_URL=
BOTCHAIN_WS_RPC_URL=
BOTCHAIN_IS_L2=true
TELEMETRY_API_KEY=
CORS_ORIGIN=https://your-website.example.com
REDIS_URL=
DATABASE_URL=

# Optional secondary networks
ETH_NETWORK_NAME=
ETH_CHAIN_ID=
ETH_HTTP_RPC_URL=
ETH_WS_RPC_URL=
BASE_NETWORK_NAME=
BASE_CHAIN_ID=
BASE_HTTP_RPC_URL=
BASE_WS_RPC_URL=
ROBINHOOD_NETWORK_NAME=
ROBINHOOD_CHAIN_ID=
ROBINHOOD_HTTP_RPC_URL=
ROBINHOOD_WS_RPC_URL=

# Contract deployment only; never put these in frontend or extension
