  "description": "Automated Counter-Drainer Engine & Multi-Chain Anti-Drainer Security System",
  "private": true,
  "dependencies": {
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "workspaces": [
    "frontend/*"
  ],
  "scripts": {
    "start:backend":   "cd backend-engine && npm start",
