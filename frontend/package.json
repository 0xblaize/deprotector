{
  "name": "@deprotector/frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix landing run dev",
    "build": "cd landing && next build && cd .. && node -e \"require('fs').cpSync('landing/.next','.next',{recursive:true})\"",
    "start": "cd landing && next start"
  },
  "dependencies": {
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2"
  }
}
